# =============================================================================
# campusEventHUB — Root .gitignore
# Covers: Python/FastAPI backend + React/Vite/Node frontend
# =============================================================================

# ---------------------------------------------------------------------------
# Python / FastAPI Backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Pytest & coverage
.pytest_cache/
.coverage
htmlcov/
*.lcov

# SQLite database files (never commit the dev DB)
*.db
*.sqlite
*.sqlite3

# Python dotenv / secrets
backend/.env
*.env.local

# MyPy / type-checking cache
.mypy_cache/
.dmypy.json

# ---------------------------------------------------------------------------
# Node / React / Vite Frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local env overrides (keep .env.example committed)
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ---------------------------------------------------------------------------
# Editor & OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
.idea/

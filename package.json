{
  "name": "campuseventhub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend/api-gateway",
    "backend/services/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n gateway,auth,user,event,registration,club,notification,announcement -c blue,green,cyan,yellow,magenta,green,cyan,white \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:event\" \"npm run dev:registration\" \"npm run dev:club\" \"npm run dev:notification\" \"npm run dev:announcement\"",
    "dev:gateway": "npm --workspace backend/api-gateway run dev",
    "dev:auth": "npm --workspace backend/services/auth-service run dev",
    "dev:user": "npm --workspace backend/services/user-service run dev",
    "dev:event": "npm --workspace backend/services/event-service run dev",
    "dev:registration": "npm --workspace backend/services/registration-service run dev",
    "dev:club": "npm --workspace backend/services/club-service run dev",
    "dev:notification": "npm --workspace backend/services/notification-service run dev",
    "dev:announcement": "npm --workspace backend/services/announcement-service run dev",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}